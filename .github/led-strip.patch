@@ -0,0 +1,426 @@
+<template>
+    <panel
+        v-if="klipperReadyForGui && strips.length"
+        :icon="mdiLedStripVariant"
+        :title="$t('Panels.LedStripPanel.Headline')"
+        :collapsible="true"
+        card-class="led-strip-panel">
+        <template #buttons>
+            <v-tooltip left>
+                <template #activator="{ on, attrs }">
+                    <v-btn
+                        v-bind="attrs"
+                        icon
+                        tile
+                        :disabled="printerIsPrintingOnly"
+                        v-on="on"
+                        @click="fillAll">
+                        <v-icon>{{ mdiFormatColorFill }}</v-icon>
+                    </v-btn>
+                </template>
+                <span>{{ $t('Panels.LedStripPanel.FillAll') }}</span>
+            </v-tooltip>
+            <v-tooltip left>
+                <template #activator="{ on, attrs }">
+                    <v-btn
+                        v-bind="attrs"
+                        icon
+                        tile
+                        :disabled="printerIsPrintingOnly"
+                        v-on="on"
+                        @click="allOff">
+                        <v-icon>{{ mdiLightbulbOff }}</v-icon>
+                    </v-btn>
+                </template>
+                <span>{{ $t('Panels.LedStripPanel.AllOff') }}</span>
+            </v-tooltip>
+        </template>
+        <v-card-text class="pt-3 pb-2">
+            <v-row v-if="strips.length > 1" dense>
+                <v-col>
+                    <v-btn-toggle v-model="selectedStrip" mandatory dense class="flex-wrap">
+                        <v-btn v-for="s in strips" :key="s.key" :value="s.key" small class="text-none">
+                            {{ s.name }}
+                        </v-btn>
+                    </v-btn-toggle>
+                </v-col>
+            </v-row>
+            <div
+                class="led-strip-bar"
+                :style="{ gridTemplateColumns: `repeat(${barColumns}, minmax(0, 1fr))` }"
+                @pointerleave="onPointerUp">
+                <div
+                    v-for="(color, idx) in currentColors"
+                    :key="idx"
+                    class="led-strip-led"
+                    :class="{
+                        'led-strip-led--disabled': printerIsPrintingOnly,
+                        'led-strip-led--selected': selected.includes(idx),
+                    }"
+                    :style="ledStyle(idx, color)"
+                    :title="$t('Panels.LedStripPanel.Led', { index: idx + 1 })"
+                    @pointerdown.prevent="onPointerDown(idx)"
+                    @pointerenter="onPointerEnter(idx)"
+                    @pointerup="onPointerUp">
+                    <span class="led-strip-index">{{ idx + 1 }}</span>
+                </div>
+            </div>
+            <v-row dense class="mt-2 align-center">
+                <v-col cols="12" class="d-flex flex-wrap align-center">
+                    <button
+                        v-for="preset in presets"
+                        :key="preset.hex"
+                        type="button"
+                        class="led-strip-swatch"
+                        :class="{ 'led-strip-swatch--active': preset.hex === paintColor }"
+                        :style="swatchStyle(preset.hex)"
+                        :title="$t(`Panels.LedStripPanel.Colors.${preset.name}`)"
+                        :disabled="printerIsPrintingOnly"
+                        @click="pickColor(preset.hex)" />
+                    <v-menu v-model="showPicker" :close-on-content-click="false" offset-y>
+                        <template #activator="{ on, attrs }">
+                            <v-btn v-bind="attrs" small icon class="ml-1" v-on="on">
+                                <v-icon :color="paintColor === '#000000' ? undefined : paintColor">
+                                    {{ mdiPalette }}
+                                </v-icon>
+                            </v-btn>
+                        </template>
+                        <v-card>
+                            <v-color-picker v-model="paintColor" mode="hexa" hide-mode-switch />
+                            <v-card-actions>
+                                <v-spacer />
+                                <v-btn
+                                    small
+                                    color="primary"
+                                    :disabled="!selected.length || printerIsPrintingOnly"
+                                    @click="applyPicker">
+                                    {{ $t('Panels.LedStripPanel.Apply') }}
+                                </v-btn>
+                            </v-card-actions>
+                        </v-card>
+                    </v-menu>
+                </v-col>
+            </v-row>
+            <v-row dense class="align-center">
+                <v-col class="d-flex align-center">
+                    <v-icon small class="mr-2">{{ mdiBrightness6 }}</v-icon>
+                    <v-slider
+                        v-model="brightness"
+                        :min="1"
+                        :max="100"
+                        hide-details
+                        dense
+                        class="mt-0"
+                        @change="applySelected" />
+                    <span class="ml-2 text-no-wrap" style="min-width: 3em; text-align: right">{{ brightness }}%</span>
+                </v-col>
+            </v-row>
+            <div class="d-flex align-center flex-wrap mt-1">
+                <span class="text-caption text--secondary mr-2">
+                    {{
+                        selected.length
+                            ? $t('Panels.LedStripPanel.Selected', { count: selected.length })
+                            : $t('Panels.LedStripPanel.Hint')
+                    }}
+                </span>
+                <v-spacer />
+                <v-btn x-small text :disabled="printerIsPrintingOnly" @click="selectAll">
+                    {{ $t('Panels.LedStripPanel.SelectAll') }}
+                </v-btn>
+                <v-btn x-small text :disabled="!selected.length" @click="selected = []">
+                    {{ $t('Panels.LedStripPanel.ClearSelection') }}
+                </v-btn>
+            </div>
+        </v-card-text>
+    </panel>
+</template>
+
+<script lang="ts">
+import { Component, Mixins, Watch } from 'vue-property-decorator'
+import BaseMixin from '@/components/mixins/base'
+import Panel from '@/components/ui/Panel.vue'
+import { mdiBrightness6, mdiFormatColorFill, mdiLedStripVariant, mdiLightbulbOff, mdiPalette } from '@mdi/js'
+
+interface LedStrip {
+    key: string
+    type: string
+    name: string
+    count: number
+}
+
+const STORAGE_KEY = 'mainsail.ledStripPanel'
+
+@Component({
+    components: { Panel },
+})
+export default class LedStripPanel extends Mixins(BaseMixin) {
+    mdiBrightness6 = mdiBrightness6
+    mdiFormatColorFill = mdiFormatColorFill
+    mdiLedStripVariant = mdiLedStripVariant
+    mdiLightbulbOff = mdiLightbulbOff
+    mdiPalette = mdiPalette
+
+    presets = [
+        { name: 'Red', hex: '#FF0000' },
+        { name: 'Orange', hex: '#FF6000' },
+        { name: 'Yellow', hex: '#FFFF00' },
+        { name: 'Green', hex: '#00FF00' },
+        { name: 'Cyan', hex: '#00FFFF' },
+        { name: 'Blue', hex: '#0000FF' },
+        { name: 'Purple', hex: '#8000FF' },
+        { name: 'Pink', hex: '#FF0080' },
+        { name: 'White', hex: '#FFFFFF' },
+        { name: 'Off', hex: '#000000' },
+    ]
+
+    selectedStrip: string | null = null
+    paintColor = '#FF0000'
+    brightness = 100
+    showPicker = false
+
+    selecting = false
+    selectAdd = true
+    dragged: number[] = []
+    selected: number[] = []
+    pendingColors: { [index: number]: number[] } = {}
+
+    created() {
+        try {
+            const saved = JSON.parse(window.localStorage.getItem(STORAGE_KEY) ?? '{}')
+            if (typeof saved.strip === 'string') this.selectedStrip = saved.strip
+            if (typeof saved.color === 'string') this.paintColor = saved.color
+            if (typeof saved.brightness === 'number') this.brightness = saved.brightness
+        } catch {
+            // ignore invalid storage
+        }
+    }
+
+    get strips(): LedStrip[] {
+        const printer = this.$store.state.printer ?? {}
+        const settings = printer.configfile?.settings ?? {}
+
+        return Object.keys(printer)
+            .filter((key) => key.startsWith('neopixel ') || key.startsWith('dotstar '))
+            .map((key) => {
+                const [type, ...rest] = key.split(' ')
+                const name = rest.join(' ')
+                const cfg = settings[key.toLowerCase()] ?? {}
+                const count = (printer[key]?.color_data ?? []).length || cfg.chain_count || 1
+                return { key, type, name, count, pin: String(cfg.pin ?? '') }
+            })
+            .filter((strip) => !strip.name.startsWith('_') && !strip.pin.startsWith('virtual:'))
+            .map(({ key, type, name, count }) => ({ key, type, name, count }))
+            .sort((a, b) => a.name.localeCompare(b.name))
+    }
+
+    get activeStrip(): LedStrip | null {
+        if (!this.strips.length) return null
+        return this.strips.find((s) => s.key === this.selectedStrip) ?? this.strips[0]
+    }
+
+    get currentColors(): number[][] {
+        if (!this.activeStrip) return []
+        const data: number[][] = this.$store.state.printer?.[this.activeStrip.key]?.color_data ?? []
+        const colors: number[][] = []
+        for (let i = 0; i < this.activeStrip.count; i++) {
+            colors.push(this.pendingColors[i] ?? data[i] ?? [0, 0, 0, 0])
+        }
+        return colors
+    }
+
+    get barColumns() {
+        const count = this.activeStrip?.count ?? 1
+        if (count <= 16) return count
+        return Math.ceil(count / Math.ceil(count / 16))
+    }
+
+    get hasLedEffects() {
+        return Object.keys(this.$store.state.printer ?? {}).some((key) => key.startsWith('led_effect '))
+    }
+
+    get paintRgb(): number[] {
+        const hex = (this.paintColor ?? '#000000').replace('#', '').slice(0, 6).padEnd(6, '0')
+        const factor = this.brightness / 100
+        return [0, 2, 4].map((i) => Math.round((parseInt(hex.slice(i, i + 2), 16) / 255) * factor * 1000) / 1000)
+    }
+
+    @Watch('selectedStrip')
+    @Watch('paintColor')
+    @Watch('brightness')
+    saveSettings() {
+        try {
+            window.localStorage.setItem(
+                STORAGE_KEY,
+                JSON.stringify({ strip: this.selectedStrip, color: this.paintColor, brightness: this.brightness })
+            )
+        } catch {
+            // ignore storage errors
+        }
+    }
+
+    @Watch('activeStrip')
+    resetPending() {
+        this.pendingColors = {}
+        this.selected = []
+    }
+
+    ledStyle(idx: number, color: number[]) {
+        const white = color[3] ?? 0
+        const [r, g, b] = [0, 1, 2].map((i) => Math.round(Math.min(1, (color[i] ?? 0) + white) * 255))
+        const lit = r + g + b > 0
+        return {
+            backgroundColor: lit ? `rgb(${r}, ${g}, ${b})` : undefined,
+            boxShadow: lit ? `0 0 10px rgba(${r}, ${g}, ${b}, 0.75)` : undefined,
+        }
+    }
+
+    swatchStyle(hex: string) {
+        if (hex === '#000000') return { background: 'repeating-linear-gradient(45deg, #444 0 4px, #222 4px 8px)' }
+        return { backgroundColor: hex }
+    }
+
+    onPointerDown(idx: number) {
+        if (this.printerIsPrintingOnly) return
+        this.selecting = true
+        this.selectAdd = !this.selected.includes(idx)
+        this.dragged = []
+        this.toggleSelect(idx)
+    }
+
+    onPointerEnter(idx: number) {
+        if (this.selecting) this.toggleSelect(idx)
+    }
+
+    onPointerUp() {
+        this.selecting = false
+        this.dragged = []
+    }
+
+    toggleSelect(idx: number) {
+        if (this.dragged.includes(idx)) return
+        this.dragged.push(idx)
+        if (this.selectAdd && !this.selected.includes(idx)) this.selected = [...this.selected, idx]
+        if (!this.selectAdd) this.selected = this.selected.filter((i) => i !== idx)
+    }
+
+    selectAll() {
+        if (!this.activeStrip) return
+        this.selected = Array.from({ length: this.activeStrip.count }, (_, i) => i)
+    }
+
+    pickColor(hex: string) {
+        this.paintColor = hex
+        this.applySelected()
+    }
+
+    applyPicker() {
+        this.applySelected()
+        this.showPicker = false
+    }
+
+    applySelected() {
+        if (!this.selected.length || this.printerIsPrintingOnly) return
+        this.selected.forEach((i) => this.$set(this.pendingColors, i, [...this.paintRgb, 0]))
+        this.sendLeds(this.selected)
+    }
+
+    fillAll() {
+        if (!this.activeStrip) return
+        const all = Array.from({ length: this.activeStrip.count }, (_, i) => i)
+        all.forEach((i) => this.$set(this.pendingColors, i, [...this.paintRgb, 0]))
+        this.sendLeds(all)
+    }
+
+    allOff() {
+        if (!this.activeStrip) return
+        const lines: string[] = []
+        if (this.hasLedEffects) lines.push(`STOP_LED_EFFECTS LEDS="${this.activeStrip.type}:${this.activeStrip.name}"`)
+        lines.push(`SET_LED LED=${this.activeStrip.name} RED=0 GREEN=0 BLUE=0 WHITE=0 SYNC=0`)
+        for (let i = 0; i < this.activeStrip.count; i++) this.$set(this.pendingColors, i, [0, 0, 0, 0])
+        this.runScript(lines)
+    }
+
+    sendLeds(indices: number[]) {
+        if (!this.activeStrip || !indices.length) return
+        const [r, g, b] = this.paintRgb
+        const sorted = [...indices].sort((a, b) => a - b)
+        const lines: string[] = []
+        if (this.hasLedEffects) lines.push(`STOP_LED_EFFECTS LEDS="${this.activeStrip.type}:${this.activeStrip.name}"`)
+        sorted.forEach((idx, n) => {
+            const transmit = n === sorted.length - 1 ? 1 : 0
+            lines.push(
+                `SET_LED LED=${this.activeStrip!.name} INDEX=${idx + 1} RED=${r} GREEN=${g} BLUE=${b} WHITE=0 TRANSMIT=${transmit} SYNC=0`
+            )
+        })
+        this.runScript(lines)
+    }
+
+    runScript(lines: string[]) {
+        const script = lines.join('\n')
+        this.$socket.emit('printer.gcode.script', { script }, { loading: 'led_strip_panel' })
+        // the printer status update replaces the optimistic colors
+        window.setTimeout(() => (this.pendingColors = {}), 1500)
+    }
+}
+</script>
+
+<style scoped>
+.led-strip-bar {
+    display: grid;
+    gap: 6px;
+    padding: 10px 8px 22px;
+    border-radius: 8px;
+    background: rgba(0, 0, 0, 0.25);
+    touch-action: none;
+    user-select: none;
+}
+
+.led-strip-led {
+    position: relative;
+    aspect-ratio: 1;
+    max-width: 44px;
+    width: 100%;
+    margin: 0 auto;
+    border-radius: 50%;
+    border: 2px solid rgba(255, 255, 255, 0.25);
+    background-color: #151515;
+    cursor: pointer;
+    transition: box-shadow 0.15s, background-color 0.15s;
+}
+
+.led-strip-led--selected {
+    border-color: var(--v-primary-base);
+    outline: 3px solid var(--v-primary-base);
+    outline-offset: 2px;
+}
+
+.led-strip-led--disabled {
+    cursor: not-allowed;
+    opacity: 0.6;
+}
+
+.led-strip-index {
+    position: absolute;
+    left: 0;
+    right: 0;
+    bottom: -18px;
+    text-align: center;
+    font-size: 10px;
+    opacity: 0.6;
+}
+
+.led-strip-swatch {
+    width: 26px;
+    height: 26px;
+    margin: 2px 3px;
+    border-radius: 50%;
+    border: 2px solid rgba(255, 255, 255, 0.25);
+    cursor: pointer;
+}
+
+.led-strip-swatch--active {
+    border-color: var(--v-primary-base);
+    outline: 2px solid var(--v-primary-base);
+    outline-offset: 1px;
+}
+</style>
